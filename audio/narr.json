{"files":["audio/n/00.mp3","audio/n/01.mp3","audio/n/02.mp3","audio/n/03.mp3","audio/n/04.mp3","audio/n/05.mp3","audio/n/06.mp3","audio/n/07.mp3","audio/n/08.mp3","audio/n/09.mp3","audio/n/10.mp3","audio/n/11.mp3","audio/n/12.mp3","audio/n/13.mp3","audio/n/14.mp3","audio/n/15.mp3","audio/n/16.mp3","audio/n/17.mp3","audio/n/18.mp3","audio/n/19.mp3","audio/n/20.mp3","audio/n/21.mp3","audio/n/22.mp3","audio/n/23.mp3","audio/n/24.mp3","audio/n/25.mp3"],"k":{"سيرة رسول اللهمن مصادر الإمامية":{"s":[0,0.0,4.824]},"محمد رسول الله":{"s":[0,5.174,2.76]},"صلى الله عليه وآله":{"s":[0,8.284,3.144]},"من عام الفيل إلى صفر سنة للهجرة، كما ترويها كتب الإمامية":{"s":[0,11.778,7.464]},"﴿اقرأ باسم ربك الذي خلق﴾":{"q":"96-1","o":"qs"},"«ولقد كان يجاور في كل سنة بحراء، فأراه ولا يراه غيري»":{"s":[0,19.592,6.576]},"تمهيد":{"s":[0,26.518,1.872]},"هذه سيرة رسول الله محمد بن عبد الله صلى الله عليه وآله كما ترويها كتب الإمامية: الكافي، والإرشاد ومسار الشيعة للشيخ المفيد، وأمالي الصدوق والمفيد، وتفسير علي بن إبراهيم القمي، ونهج البلاغة الذي يصفه فيه علي عليه السلام بعين من لزمه منذ طفولته. ولد في عام الفيل، وبعث على رأس الأربعين، ودعا قومه ثلاث عشرة سنة بمكة، ثم هاجر إلى المدينة فأقام بها عشرا. مرر الصفحة كما تمر السنون؛ والعداد في أعلى الشاشة يحسب عمره.":{"s":[0,28.74,43.272]},"سنة عاشها، «وهو ابن ثلاث وستين سنة» حين قبض (الكافي :)":{"s":[0,72.362,7.008]},"سنة بين مولده ومبعثه: ولد «قبل أن يبعث بأربعين سنة» (الكافي :)":{"s":[0,79.72,7.08]},"سنة بمكة بعد البعثة: «وبقي بمكة بعد مبعثه ثلاث عشرة سنة» (الكافي :)":{"s":[0,87.15,7.968]},"سنين بالمدينة: «ثم هاجر إلى المدينة ومكث بها عشر سنين» (الكافي :)":{"s":[1,0.0,6.648]},"قبل مولدهمن عدنان إلى عبد الله":{"s":[1,6.998,4.08]},"النور في الأصلاب":{"s":[1,11.428,2.52]},"علي عليه السلام يذكر منبته، نهج البلاغة، الخطبة":{"s":[1,14.298,7.512]},"«حتى أفضت كرامة الله سبحانه وتعالى إلى محمد صلى الله عليه وآله، فأخرجه من أفضل المعادن منبتا، وأعز الأرومات مغرسا، من الشجرة التي صدع منها أنبياءه، وانتجب منها أمناءه»":{"s":[1,22.16,17.28]},"يمر النور على آبائه من عدنان إلى عبد الله، ثم إليه صلى الله عليه وآله. ويقف النسب عند عدنان كما أمر: «إذا بلغ نسبي عدنان فأمسكوا» (إعلام الورى :).":{"s":[1,39.79,14.184]},"«ونسبه: محمد بن عبد الله بن عبد المطلب، واسمه شيبة الحمد، بن هاشم، واسمه عمرو، بن عبد مناف، واسمه المغيرة، بن قصي، واسمه زيد، ابن كلاب بن مرة بن كعب بن لؤي بن غالب بن فهر بن مالك بن النضر، وهو قريش، بن كنانة بن خزيمة بن مدركة بن إلياس بن مضر بن نزار بن معد بن عدنان»":{"s":[1,54.324,29.232]},"وفي الصفحة نفسها عنه صلى الله عليه وآله: «إذا بلغ نسبي عدنان فأمسكوا».":{"s":[1,83.906,7.608]},"عام الفيلمكة":{"s":[2,0.0,3.264]},"أصحاب الفيل":{"s":[2,3.614,2.376]},"﴿ألم تر كيف فعل ربك بأصحاب الفيل﴾":{"q":"105-1","o":"qs"},"«نزلت في الحبشة حين جاءوا بالفيل ليهدموا به الكعبة»":{"s":[2,6.34,5.136]},"﴿ألم يجعل كيدهم في تضليل﴾":{"q":"105-2","o":"qs"},"﴿وأرسل عليهم طيرا أبابيل ۝ ترميهم بحجارة من سجيل﴾":{"q":"105-3_4","o":"qs"},"﴿فجعلهم كعصف مأكول﴾":{"q":"105-5","o":"qs"},"«وفي السابع عشر منه مولد سيدنا رسول الله صلى الله عليه وآله عند طلوع الفجر من يوم الجمعة في عام الفيل»":{"s":[2,11.826,10.008]},"عن الإمام الصادق عليه السلام: «لما أن وجه صاحب الحبشة بالخيل ومعهم الفيل ليهدم البيت، مروا بإبل لعبد المطلب»، فأخذوها، فخرج إليه عبد المطلب يطلبها وقال:":{"s":[2,22.184,16.032]},"«أنا رب الإبل، ولهذا البيت رب يمنعه»":{"s":[2,38.566,4.704]},"وفي الطير: «هو طير كثير، ولا أعرفه، يحمل كل طير في منقاره حصاة مثل حصاة الخذف».":{"s":[2,43.62,9.36]},"ربيع الأول، عام الفيلمكة":{"s":[2,53.33,5.64]},"المولد":{"s":[2,59.32,1.872]},"«وفي السابع عشر منه مولد سيدنا رسول الله صلى الله عليه وآله عند طلوع الفجر من يوم الجمعة في عام الفيل، وهو يوم شريف، عظيم البركة»":{"s":[2,61.542,13.368]},"وفي الكافي: «ولد النبي صلى الله عليه وآله لاثنتي عشرة ليلة مضت من شهر ربيع الأول في عام الفيل يوم الجمعة مع الزوال، وروي أيضا عند طلوع الفجر». والمشهور عند الإمامية قول المفيد. وفي الكافي أيضا أنه ولد في شعب أبي طالب بمكة.":{"s":[2,75.26,23.208]},"طفولتهمن يثرب إلى مكة":{"s":[3,0.0,3.816]},"اليتم والكفالة":{"s":[3,4.166,2.76]},"﴿ألم يجدك يتيما فآوى﴾":{"q":"93-6","o":"qs"},"عبد الله بن عبد المطلب":{"s":[3,7.276,3.216]},"«وتوفي أبوه عبد الله بن عبد المطلب بالمدينة عند أخواله وهو ابن شهرين»":{"s":[3,10.842,7.296]},"آمنة بنت وهب":{"s":[3,18.488,2.4]},"«وماتت أمه آمنة بنت وهب … وهو عليه السلام ابن أربع سنين»":{"s":[3,21.238,6.648]},"عبد المطلب":{"s":[3,28.236,2.232]},"«… وأما حجر كفلك فحجر أبي طالب»":{"s":[3,30.818,4.128]},"«وتوفي أبوه عبد الله بن عبد المطلب بالمدينة عند أخواله وهو ابن شهرين … وماتت أمه آمنة بنت وهب بن عبد مناف بن زهرة … وهو عليه السلام ابن أربع سنين … ومات عبد المطلب وللنبي صلى الله عليه وآله نحو ثمان سنين»":{"s":[3,35.296,20.448]},"وفي بعض نسخ الكافي: «ثلاث سنين» مكان «أربع سنين». وفي رواية الكافي أن أباه مات بعد مولده بشهرين، لا قبله.":{"s":[3,56.094,12.672]},"فكفله عمه أبو طالب. وعن الإمام الصادق عليه السلام، فيما نزل به جبرئيل عليه السلام:":{"s":[3,69.116,10.032]},"«إني قد حرمت النار على صلب أنزلك، وبطن حملك، وحجر كفلك … وأما حجر كفلك فحجر أبي طالب»":{"s":[3,79.498,10.344]},"شبابهمكة":{"s":[4,0.0,2.832]},"خديجة":{"s":[4,3.182,2.016]},"«وتزوج خديجة وهو ابن بضع وعشرين سنة» وفي مسار الشيعة: «تزوج النبي صلى الله عليه وآله بخديجة بنت خويلد أم المؤمنين رضي الله عنها» … «لخمس وعشرين سنة من مولده، وكان لها يومئذ أربعون سنة».":{"s":[4,5.548,19.08]},"«أفضل نساء أهل الجنة أربع: خديجة بنت خويلد، وفاطمة بنت محمد، ومريم بنت عمران، وآسية بنت مزاحم امرأة فرعون»":{"s":[4,24.978,12.864]},"رجب، على رأس الأربعينغار حراء":{"s":[4,38.192,6.552]},"حراء والمبعث":{"s":[4,45.094,2.568]},"«نزل جبرئيل على محمد صلى الله عليه وآله فقال: يا محمد، اقرأ. قال: وما أقرأ؟ قال: اقرأ باسم ربك الذي خلق»":{"s":[4,48.012,14.712]},"﴿اقرأ باسم ربك الذي خلق ۝ خلق الإنسان من علق ۝ اقرأ وربك الأكرم ۝ الذي علم بالقلم ۝ علم الإنسان ما لم يعلم﴾":{"q":"96-1_5","o":"qs"},"رجب، على رأس الأربعين":{"s":[4,63.074,5.28]},"«وفي اليوم السابع والعشرين منه كان مبعث النبي صلى الله عليه وآله»":{"s":[4,68.704,6.6]},"البيت الأول":{"s":[4,75.654,2.232]},"«ولم يجمع بيت واحد يومئذ في الإسلام غير رسول الله صلى الله عليه وآله وخديجة وأنا ثالثهما، أرى نور الوحي والرسالة، وأشم ريح النبوة»":{"s":[4,78.236,13.512]},"السنة الثالثة من البعثةمكة":{"s":[5,0.0,4.056]},"يوم الإنذار":{"s":[5,4.406,2.256]},"﴿وأنذر عشيرتك الأقربين﴾":{"q":"26-214","o":"qs"},"فجمع رسول الله صلى الله عليه وآله بني عبد المطلب، فأطعمهم، ثم قال لهم:":{"s":[5,7.012,8.568]},"«فمن يجبني إلى هذا الأمر ويؤازرني عليه وعلى القيام به، يكن أخي ووصيي ووزيري ووارثي وخليفتي من بعدي»":{"s":[5,15.93,10.008]},"فسكت القوم، وقام علي عليه السلام، يقول: «وأنا إذ ذاك أصغرهم سنا». وأعادها رسول الله ثلاثا، وفي كل مرة لا يقوم غيره.":{"s":[5,26.288,14.184]},"«اجلس، فأنت أخي ووصيي ووزيري ووارثي وخليفتي من بعدي»":{"s":[5,40.822,6.6]},"أربع سنين، في رواية القميشعب أبي طالب":{"s":[5,47.772,5.64]},"الشعب":{"s":[5,53.762,1.872]},"«فلما اجتمعت قريش على قتل رسول الله صلى الله عليه وآله وكتبوا الصحيفة القاطعة، جمع أبو طالب بني هاشم …»":{"s":[5,55.984,10.464]},"«فأدخله الشعب، وكان يحرسه بالليل والنهار، قائما على رأسه بالسيف، أربع سنين»":{"s":[5,66.798,9.048]},"«فإذا جاء الليل يقوم بالسيف عليه ورسول الله مضطجع، ثم يقيمه ويضجعه في موضع آخر، فلا يزال الليل كله هكذا»":{"s":[5,76.196,11.568]},"أربع سنين، في رواية القمي":{"s":[5,88.114,4.104]},"«فأصابهم الجهد وجاعوا»":{"s":[6,0.0,3.168]},"«بعث الله على صحيفتهم القاطعة دابة الأرض فلحست جميع ما فيها من قطيعة رحم وظلم وجور، وتركت اسم الله» … «فإذا ليس فيها حرف واحد إلا: باسمك اللهم»":{"s":[6,3.518,14.712]},"«وخرج النبي من الشعب ورهطه وخالطوا الناس»":{"s":[6,18.58,4.824]},"قبل الهجرةمن المسجد الحرام إلى المسجد الأقصى":{"s":[6,23.754,5.04]},"الإسراء والمعراج":{"s":[6,29.144,2.808]},"﴿سبحان الذي أسرى بعبده ليلا من المسجد الحرام إلى المسجد الأقصى الذي باركنا حوله لنريه من آياتنا﴾":{"q":"17-1a","o":"qs"},"«جاء جبرئيل وميكائيل وإسرافيل بالبراق إلى رسول الله»":{"s":[6,32.302,5.424]},"«فصعد جبرئيل وصعدت معه إلى سماء الدنيا»":{"s":[6,38.076,4.872]},"﴿عند سدرة المنتهى ۝ عندها جنة المأوى ۝ إذ يغشى السدرة ما يغشى ۝ ما زاغ البصر وما طغى﴾":{"q":"53-14_17","o":"qs"},"﴿فكان قاب قوسين أو أدنى﴾":{"q":"53-9","o":"qs"},"وعن الإمام الصادق عليه السلام، يروي عن رسول الله صلى الله عليه وآله: «ثم ركبت فمضينا حتى انتهينا إلى بيت المقدس، فربطت البراق بالحلقة التي كانت الأنبياء تربط بها»":{"s":[6,43.298,15.96]},"«فوجدنا إبراهيم وموسى وعيسى فيمن شاء الله من أنبياء الله قد جمعوا إلي … فقدمني فأممتهم، ولا فخر»":{"s":[6,59.608,9.768]},"قبل الهجرة بسنةمكة":{"s":[6,69.726,3.384]},"عام الحزن":{"s":[6,73.46,2.16]},"«وماتت خديجة عليها السلام حين خرج رسول الله صلى الله عليه وآله من الشعب، وكان ذلك قبل الهجرة بسنة، ومات أبو طالب بعد موت خديجة بسنة»":{"s":[6,75.97,13.68]},"ودخل على عمه وهو يجود بنفسه فقال: «يا عم، ربيت صغيرا، وكفلت يتيما، فجزاك الله عني خيرا».":{"s":[7,0.0,11.304]},"«إن مثل أبي طالب مثل أصحاب الكهف، أسروا الإيمان وأظهروا الشرك، فآتاهم الله أجرهم مرتين»":{"s":[7,11.654,9.24]},"«فلما فقدهما رسول الله صلى الله عليه وآله شنأ المقام بمكة، ودخله حزن شديد، وشكا ذلك إلى جبرئيل عليه السلام، فأوحى الله تعالى إليه: اخرج من القرية الظالم أهلها، فليس لك بمكة ناصر بعد أبي طالب، وأمره بالهجرة»":{"s":[7,21.244,21.96]},"ربيع الأول، سنة من المبعثمن مكة إلى المدينة":{"s":[7,43.554,7.512]},"الهجرة":{"s":[7,51.416,2.04]},"ليلة المبيت، مكة، السنة الثالثة عشرة من البعثة":{"s":[7,53.806,6.096]},"وجاءه القوم الذين تمالؤوا على قتله فأحدقوا به وعليهم السلاح، يرصدون طلوع الفجر ليقتلوه ظاهرا، فيذهب دمه فرغا بمشاهدة بني هاشم قاتليه من جميع القبائل.":{"s":[7,60.252,15.504]},"فبات عليه السلام على فراش رسول الله صلى الله عليه وآله مستترا بإزاره، وخرج رسول الله إلى الغار.":{"s":[7,76.106,9.96]},"﴿ومن الناس من يشري نفسه ابتغاء مرضات الله ۗ والله رءوف بالعباد﴾":{"q":"2-207","o":"qs"},"«فوهب أمير المؤمنين عليه السلام نفسه لله، وشراها من الله»":{"s":[7,86.416,6.312]},"﴿وإذ يمكر بك الذين كفروا ليثبتوك أو يقتلوك أو يخرجوك ويمكرون ويمكر الله والله خير الماكرين﴾":{"q":"8-30","o":"qs"},"﴿إلا تنصروه فقد نصره الله إذ أخرجه الذين كفروا ثاني اثنين إذ هما في الغار﴾":{"q":"9-40a","o":"qs"},"«وبعث الله العنكبوت فنسجت على باب الغار»":{"s":[8,0.0,4.704]},"«فأقام صلى الله عليه وآله بالغار، وهو في جبل عظيم خارج مكة غير بعيد منها اسمه ثور، ثلاثة أيام وثلاث ليال»":{"s":[8,5.054,11.976]},"«وقدم المدينة لاثنتي عشرة ليلة خلت من شهر ربيع الأول مع زوال الشمس، فنزل بقبا»":{"s":[8,17.38,8.544]},"«شهر ربيع الأول: أول ليلة منه هاجر رسول الله صلى الله عليه وآله من مكة إلى المدينة سنة ثلاث عشرة من مبعثه، وكانت ليلة الخميس»":{"s":[8,26.274,13.32]},"ونزل بقبا، «فصلى الظهر ركعتين والعصر ركعتين» ، وأقام بها ينتظر عليا عليه السلام، وقال:":{"s":[8,39.944,10.272]},"«إني أنتظر علي بن أبي طالب، وقد أمرته أن يلحقني، ولست مستوطنا منزلا حتى يقدم علي، وما أسرعه إن شاء الله»":{"s":[8,50.566,11.04]},"السنة الأولى للهجرةالمدينة":{"s":[8,61.956,3.912]},"المسجد والمؤاخاة":{"s":[8,66.218,2.688]},"وبنى مسجده بيده مع أصحابه. عن الإمام الصادق عليه السلام: «إن رسول الله صلى الله عليه وآله بنى مسجده بالسميط، ثم إن المسلمين كثروا فقالوا: يا رسول الله، لو أمرت بالمسجد فزيد فيه؟ فقال: نعم، فأمر به فزيد فيه».":{"s":[8,69.256,23.472]},"«فأقبل رسول الله صلى الله عليه وآله وسلم يحمل حجرا على بطنه، فاستقبله أسيد ابن حضير فقال: يا رسول الله، أعطني أحمله عنك. قال: لا، اذهب فاحمل غيره»":{"s":[9,0.0,17.208]},"«فقالوا: يا رسول الله، لو أمرت بالمسجد فطين؟ فقال لهم رسول الله صلى الله عليه وآله: لا، عريش كعريش موسى عليه السلام. فلم يزل كذلك حتى قبض رسول الله صلى الله عليه وآله».":{"s":[9,17.558,19.608]},"المؤاخاة":{"s":[9,37.516,2.064]},"«آخى رسول الله صلى الله عليه وآله بين أصحابه، وترك عليا»":{"s":[9,39.93,6.912]},"«والذي نفسي بيده، ما أخرتك إلا لنفسي، أنت أخي ووصيي ووارثي»":{"s":[9,47.192,7.032]},"فاطمة الزهراء عليها السلام":{"s":[9,54.574,3.6]},"وزوج ابنته فاطمة عليها السلام من علي عليه السلام. وعن الإمام الصادق عليه السلام:":{"s":[9,58.524,9.192]},"«لولا أن الله تبارك وتعالى خلق أمير المؤمنين عليه السلام لفاطمة ما كان لها كفؤ على ظهر الأرض، من آدم ومن دونه»":{"s":[9,68.066,10.728]},"«يا علي، إن فاطمة بضعة مني، وهي نور عيني، وثمرة فؤادي، يسوءني ما ساءها، ويسرني ما سرها، وإنها أول من يلحقني من أهل بيتي، فأحسن إليها بعدي»":{"s":[9,79.144,16.008]},"رمضان هآبار بدر":{"s":[10,0.0,6.384]},"بدر":{"s":[10,6.734,1.872]},"يوم الفرقان":{"s":[10,8.956,2.4]},"قال أمير المؤمنين عليه السلام: «ولقد رأيتنا ليلة بدر وما فينا إلا من نام، غير رسول الله صلى الله عليه وآله فإنه كان منتصبا في أصل شجرة يصلي ويدعو حتى الصباح»":{"s":[10,11.706,16.032]},"فنادى عتبة رسول الله صلى الله عليه وآله فقال: يا محمد، أخرج إلينا أكفاءنا من قريش… ثم قال: «قم يا علي، قم يا حمزة، قم يا عبيدة، قاتلوا على حقكم الذي بعث الله به نبيكم، إذ جاؤوا بباطلهم ليطفؤوا نور الله»":{"s":[10,28.088,21.216]},"خرج عتبة وشيبة ابنا ربيعة والوليد بن عتبة يطلبون البراز، فخرج إليهم عبيدة بن الحارث وحمزة وعلي: «وبارز الوليد أمير المؤمنين فلم يلبثه حتى قتله».":{"s":[10,49.654,15.0]},"قال رسول الله صلى الله عليه وآله: «غضوا أبصاركم، وعضوا على النواجذ، ولا تسلوا سيفا حتى آذن لكم». ثم رفع يده إلى السماء وقال: «يا رب، إن تهلك هذه العصابة لم تعبد، وإن شئت أن لا تعبد لا تعبد»":{"s":[10,65.004,20.832]},"﴿إذ تستغيثون ربكم فاستجاب لكم أني ممدكم بألف من الملائكة مردفين﴾":{"q":"8-9","o":"qs"},"«وهو يسلت العرق عن وجهه ويقول: هذا جبرئيل قد أتاكم في ألف من الملائكة مردفين»":{"s":[10,86.186,8.856]},"كان قتلى المشركين يوم بدر سبعين، يعد الشيخ المفيد منهم: «فذلك خمسة وثلاثون رجلا، سوى من اختلف فيه، أو شرك أمير المؤمنين عليه السلام فيه غيره، وهم أكثر من شطر المقتولين».":{"s":[11,0.0,17.304]},"ثم أخذ رسول الله صلى الله عليه وآله كفا من حصى، فرمى به وجوه قريش وقال: «شاهت الوجوه»، فبعث الله رياحا تضرب في وجوه قريش، فكانت الهزيمة.":{"s":[11,17.654,15.456]},"﴿وما رميت إذ رميت ولكن الله رمى﴾":{"q":"8-17a","o":"qs"},"﴿ولقد نصركم الله ببدر وأنتم أذلة﴾":{"q":"3-123a","o":"qs"},"شوال هسفح أحد":{"s":[11,33.46,5.04]},"أحد":{"s":[11,38.85,1.872]},"صباح أحد":{"s":[11,41.072,2.376]},"وأقام رسول الله صلى الله عليه وآله على الشعب «خمسين رجلا من الأنصار، وأمر عليهم رجلا منهم، وقال: لا تبرحوا عن مكانكم هذا وإن قتلنا عن آخرنا، فإنما نؤتى من موضعكم هذا»":{"s":[11,43.798,17.28]},"حين انكشف المسلمون":{"s":[11,61.428,2.904]},"ترك الرماة الجبل، والتف المشركون من خلفهم، فانهزم الناس عن رسول الله صلى الله عليه وآله، وثبت علي يذب عنه.":{"s":[11,64.682,11.52]},"«وأقبلوا يصعدون في الجبال وفي كل وجه، فلما رأى رسول الله صلى الله عليه وآله الهزيمة كشف البيضة عن رأسه وقال: إني أنا رسول الله، إلى أين تفرون عن الله وعن رسوله»":{"s":[11,76.552,16.128]},"﴿إذ تصعدون ولا تلوون على أحد والرسول يدعوكم في أخراكم﴾":{"q":"3-153a","o":"qs"},"«فحملوا عليه حملة رجل واحد ضربا بالسيوف وطعنا بالرماح ورميا بالنبل ورضخا بالحجارة»":{"s":[12,0.0,8.448]},"«ففتح رسول الله صلى الله عليه وآله عينيه فنظر إلى أمير المؤمنين عليه السلام، وقد كان أغمي عليه مما ناله، فقال: يا علي، ما فعل الناس؟ قال: نقضوا العهد وولوا الدبر، فقال له: فاكفني هؤلاء الذين قد قصدوا قصدي»":{"s":[12,8.798,22.512]},"«فلما انقطع سيف أمير المؤمنين عليه السلام جاء إلى رسول الله صلى الله عليه وآله فقال: يا رسول الله، إن الرجل يقاتل بالسلاح وقد انقطع سيفي، فدفع إليه رسول الله صلى الله عليه وآله سيفه ذا الفقار فقال: قاتل بهذا»":{"s":[12,31.66,21.648]},"فقال جبرئيل: «إن هذه لهي المواساة يا محمد»، فقال: «إنه مني وأنا منه»، فقال جبرئيل: «وأنا منكما يا محمد».":{"s":[12,53.658,12.336]},"لا سيف إلا ذو الفقار، ولا فتى إلا علي":{"s":[12,66.344,4.824]},"نادى مناد من السماء يوم أحد":{"s":[12,71.518,3.672]},"«فانحاز رسول الله صلى الله عليه وآله إلى ناحية أحد، فوقف»":{"s":[12,75.54,6.936]},"﴿وما محمد إلا رسول قد خلت من قبله الرسل﴾":{"q":"3-144a","o":"qs"},"شوال هشمال المدينة":{"s":[12,82.826,5.304]},"الخندق":{"s":[12,88.48,1.872]},"برز الإيمان كله إلى الشرك كله":{"s":[13,0.0,3.768]},"حفر الخندق":{"s":[13,4.118,2.184]},"«وبدأ رسول الله وأخذ معولا، فحفر في موضع المهاجرين بنفسه، وأمير المؤمنين عليه السلام ينقل التراب من الحفرة، حتى عرق رسول الله صلى الله عليه وآله وعيي»":{"s":[13,6.652,15.288]},"وقال:":{"s":[13,22.29,1.944]},"«لا عيش إلا عيش الآخرة، اللهم اغفر للأنصار والمهاجرين»":{"s":[13,24.584,6.288]},"قال جابر بن عبد الله الأنصاري":{"s":[13,31.222,3.672]},"«إذ عرض لهم جبل لم تعمل المعاول فيه»":{"s":[13,35.244,4.272]},"«ثم أخذ معولا فضرب ضربة فبرقت برقة، فنظرنا فيها إلى قصور الشام، ثم ضرب أخرى فبرقت برقة نظرنا فيها إلى قصور المدائن، ثم ضرب أخرى فبرقت برقة أخرى نظرنا فيها إلى قصور اليمن»":{"s":[13,39.866,17.208]},"فقال رسول الله صلى الله عليه وآله:":{"s":[13,57.424,4.488]},"«أما إنه سيفتح الله عليكم هذه المواطن التي برقت فيها البرق»":{"s":[13,62.262,5.904]},"الأحزاب":{"s":[13,68.516,2.04]},"«حتى اجتمعوا قدر عشرة آلاف من قريش وكنانة … فبلغ ذلك رسول الله صلى الله عليه وآله فاستشار أصحابه، وكانوا سبعمائة رجل»":{"s":[13,70.906,12.408]},"﴿إذ جاءوكم من فوقكم ومن أسفل منكم وإذ زاغت الأبصار وبلغت القلوب الحناجر﴾":{"q":"33-10a","o":"qs"},"عبر عمرو بن عبد ود الخندق، فارس العرب، ونادى: هل من مبارز؟ فسكت الناس، وقام علي عليه السلام فقال: أنا له يا رسول الله.":{"s":[13,83.664,14.64]},"«فقال رسول الله صلى الله عليه وآله: ادن مني، فدنا منه فعممه بيده، ودفع إليه سيفه ذا الفقار، فقال له: اذهب وقاتل بهذا»":{"s":[14,0.0,13.8]},"«اللهم احفظه من بين يديه ومن خلفه، وعن يمينه وعن شماله، ومن فوقه ومن تحته»":{"s":[14,14.15,8.328]},"«وكانوا في وقت برد شديد، وأصابتهم مجاعة … فلما رأى رسول الله صلى الله عليه وآله من أصحابه الجزع لطول الحصار، صعد إلى مسجد الفتح … فدعا الله وناجاه»":{"s":[14,22.828,15.288]},"«يا صريخ المكروبين، ويا مجيب المضطرين، ويا كاشف الكرب العظيم … اكشف عنا غمنا وهمنا وكربنا»":{"s":[14,38.466,10.2]},"«فنزل عليه جبرئيل فقال: يا محمد، إن الله قد سمع مقالتك، وأجاب دعوتك، وأمر الدبور، وهي الريح، مع الملائكة أن تهزم قريشا والأحزاب»":{"s":[14,49.016,14.952]},"﴿يا أيها الذين آمنوا اذكروا نعمة الله عليكم إذ جاءتكم جنود فأرسلنا عليهم ريحا وجنودا لم تروها﴾":{"q":"33-9a","o":"qs"},"﴿وكفى الله المؤمنين القتال﴾":{"q":"33-25a","o":"qs"},"«لضربة علي لعمرو يوم الخندق تعدل عبادة الثقلين»":{"s":[14,64.318,5.472]},"وقول النبي صلى الله عليه وآله «برز الإيمان كله إلى الشرك كله» في بحار الأنوار : عن الكراجكي":{"s":[14,70.14,9.576]},"ذو القعدة هالحديبية":{"s":[14,80.066,5.112]},"صلح الحديبية":{"s":[14,85.528,2.592]},"ذو القعدة ه":{"s":[14,88.47,3.984]},"خرج معتمرا، فصدته قريش عن البيت":{"s":[15,0.0,4.872]},"فصالحها على أن يرجع عامه ويعتمر من قابل":{"s":[15,5.222,4.992]},"«وأن يجعل أمير المؤمنين عليه السلام كاتبه يومئذ، والمتولي لعقد الصلح بخطه. فقال له النبي عليه وآله السلام: اكتب يا علي: بسم الله الرحمن الرحيم»":{"s":[15,10.564,15.576]},"وأبى المشركون أن يكتب «بسم الله الرحمن الرحيم» و«رسول الله»، فقال علي: «يا رسول الله، إن يدي لا تنطلق بمحو اسمك من النبوة».":{"s":[15,26.49,12.672]},"«فمحاها رسول الله صلى الله عليه وآله بيده، وقال لأمير المؤمنين عليه السلام: ستدعى إلى مثلها فتجيب وأنت على مضض»":{"s":[15,39.512,11.664]},"﴿لتدخلن المسجد الحرام إن شاء الله آمنين﴾":{"q":"48-27a","o":"qs"},"﴿إنا فتحنا لك فتحا مبينا﴾":{"q":"48-1","o":"qs"},"هحصون خيبر":{"s":[15,51.526,4.224]},"خيبر":{"s":[15,56.1,1.872]},"خيبر، ه":{"s":[15,58.322,3.864]},"«لما دنا رسول الله صلى الله عليه وآله من خيبر، قال للناس: قفوا، فوقف الناس، فرفع يديه إلى السماء وقال:":{"s":[15,62.536,12.12]},"اللهم رب السماوات السبع وما أظللن … أسألك خير هذه القرية وخير ما فيها، وأعوذ بك من شرها وشر ما فيها»":{"s":[15,75.006,10.656]},"«وحاصر رسول الله صلى الله عليه وآله خيبر بضعا وعشرين ليلة»":{"s":[15,86.012,6.84]},"ثم قال معلنا:":{"s":[16,0.0,2.544]},"«لأعطين الراية غدا رجلا يحبه الله ورسوله، ويحب الله ورسوله، كرارا غير فرار، لا يرجع حتى يفتح الله على يديه»":{"s":[16,2.894,12.24]},"«اجلس وضع رأسك على فخذي»":{"s":[16,15.484,3.456]},"«فجيء به وهو أرمد، فتفل في عينه»":{"s":[16,19.29,4.512]},"«وأعطاه الراية، وكانت راية بيضاء، وقال له:":{"s":[16,24.152,5.688]},"خذ الراية وامض بها، فجبرئيل معك، والنصر أمامك، والرعب مبثوث في صدور القوم»":{"s":[16,30.19,8.76]},"فبرز إليه مرحب، فأجابه علي عليه السلام: «أنا الذي سمتني أمي حيدره»":{"s":[16,39.3,7.632]},"واقتلع باب الحصن فتترس به، ثم رمى به خلف ظهره.":{"s":[16,47.282,5.592]},"«فلم يقله منهم إلا سبعون رجلا»":{"s":[16,53.224,4.032]},"«والله ما قلعت باب خيبر ورميت بها خلف ظهري أربعين ذراعا بقوة جسدية، ولا حركة غذائية، لكني أيدت بقوة ملكوتية، ونفس بنور ربها مضية»":{"s":[16,57.606,14.688]},"﴿وأثابهم فتحا قريبا ۝ ومغانم كثيرة يأخذونها﴾":{"q":"48-18_19a","o":"qs"},"رمضان همكة":{"s":[16,72.644,4.92]},"فتح مكة":{"s":[16,77.914,2.184]},"فتح مكة، رمضان ه":{"s":[16,80.448,6.12]},"صنما حول الكعبة":{"s":[16,86.918,4.248]},"كان بعضها مشدودا ببعض بالرصاص":{"s":[17,0.0,3.96]},"﴿وقل جاء الحق وزهق الباطل ۚ إن الباطل كان زهوقا﴾":{"q":"17-81","o":"qs"},"«أعطني يا علي كفا من الحصى»، فقبض له أمير المؤمنين كفا فناوله، فرماها به وهو يقول: ﴿قل جاء الحق وزهق الباطل﴾":{"q":"17-81a","o":"sq","s":[17,4.31,9.168]},"«فما بقي منها صنم إلا خر لوجهه، ثم أمر بها فأخرجت من المسجد فطرحت وكسرت»":{"s":[17,13.828,8.424]},"«وجد فيه ثلاثمائة وستين صنما، بعضها مشدود ببعض بالرصاص».":{"s":[17,22.602,7.032]},"شوال هوادي حنين":{"s":[17,29.984,5.376]},"حنين":{"s":[17,35.71,1.872]},"حنين، ه":{"s":[17,37.932,3.984]},"«فلما التقوا مع المشركين لم يلبثوا حتى انهزموا بأجمعهم، فلم يبق منهم مع النبي صلى الله عليه وآله إلا عشرة أنفس: تسعة من بني هاشم خاصة، وعاشرهم أيمن بن أم أيمن، فقتل أيمن رحمه الله، وثبت تسعة النفر الهاشميون حتى ثاب إلى رسول الله صلى الله عليه وآله من كان انهزم»":{"s":[17,42.266,26.496]},"ذي الحجة هالمدينة، مع نصارى نجران":{"s":[17,69.112,8.16]},"المباهلة والكساء":{"s":[17,77.622,2.808]},"﴿فمن حاجك فيه من بعد ما جاءك من العلم فقل تعالوا ندع أبناءنا وأبناءكم ونساءنا ونساءكم وأنفسنا وأنفسكم ثم نبتهل فنجعل لعنت الله على الكاذبين﴾":{"q":"3-61","o":"qs"},"«جاء النبي آخذا بيد أمير المؤمنين علي بن أبي طالب، والحسن والحسين بين يديه يمشيان، وفاطمة صلوات الله عليهم تمشي خلفه»":{"s":[17,80.78,12.408]},"رسول الله":{"s":[18,0.0,2.16]},"علي":{"s":[18,2.51,1.872]},"فاطمة":{"s":[18,4.732,1.896]},"الإمام الحسن":{"s":[18,6.978,2.4]},"الإمام الحسين":{"s":[18,9.728,2.544]},"«فأدخلهم رسول الله تحت الكساء في بيت أم سلمة، ثم قال: اللهم إن لكل نبي أهلا وثقلا، وهؤلاء أهل بيتي وثقلي»":{"s":[18,12.622,11.904]},"﴿إنما يريد الله ليذهب عنكم الرجس أهل البيت ويطهركم تطهيرا﴾":{"q":"33-33a","o":"qs"},"ذي الحجة هغدير خم":{"s":[18,24.876,6.12]},"حجة الوداع والغدير":{"s":[18,31.346,2.928]},"غدير خم، ذي الحجة ه":{"s":[18,34.624,6.672]},"﴿يا أيها الرسول بلغ ما أنزل إليك من ربك ۖ وإن لم تفعل فما بلغت رسالته ۚ والله يعصمك من الناس﴾":{"q":"5-67a","o":"qs"},"وأمر بجمع الرحال في ذلك المكان، ووضع بعضها على بعض، ثم صعد عليها حتى صار في ذروتها.":{"s":[18,41.646,9.48]},"ورفع يد علي حتى رئي بياض إبطيهما":{"s":[18,51.476,4.512]},"«من كنت مولاه فهذا علي مولاه، اللهم وال من والاه، وعاد من عاداه، وانصر من نصره، واخذل من خذله»":{"s":[18,56.338,10.536]},"﴿اليوم أكملت لكم دينكم وأتممت عليكم نعمتي ورضيت لكم الإسلام دينا﴾":{"q":"5-3a","o":"qs"},"صفر ه، في رواية المفيدالمدينة":{"s":[18,67.224,8.616]},"الرحيل":{"s":[18,76.19,1.872]},"«ثم إنه عقد لأسامة بن زيد بن حارثة الإمرة، وندبه أن يخرج بجمهور الأمة إلى حيث أصيب أبوه من بلاد الروم»":{"s":[18,78.412,10.416]},"واشتد به المرض، فقال: «ائتوني بدواة وكتف، أكتب لكم كتابا لا تضلوا بعده أبدا» … «ولكنني أوصيكم بأهل بيتي خيرا».":{"s":[18,89.178,12.072]},"«ضع رأسي يا علي في حجرك، فقد جاء أمر الله عز وجل، فإذا فاضت نفسي فتناولها بيدك وامسح بها وجهك، ثم وجهني إلى القبلة، وتول أمري، وصل علي أول الناس، ولا تفارقني حتى تواريني في رمسي»":{"s":[19,0.0,19.2]},"نهج البلاغة، الخطبة":{"s":[19,19.55,5.4]},"ولقد قبض رسول الله صلى الله عليه وآله وإن رأسه لعلى صدري، ولقد سالت نفسه في كفي، فأمررتها على وجهي، ولقد وليت غسله صلى الله عليه وآله والملائكة أعواني":{"s":[19,25.3,16.464]},"«وتولى عليه السلام غسله وتحنيطه وتكفينه، والفضل يعاطيه الماء ويعينه عليه»":{"s":[19,42.114,7.992]},"«وكان ذلك في يوم الاثنين لليلتين بقيتا من صفر سنة إحدى عشرة من هجرته، وهو ابن ثلاث وستين سنة»":{"s":[19,50.456,9.792]},"وفي الكافي: «ثم قبض عليه السلام لاثنتي عشرة ليلة مضت من ربيع الأول يوم الإثنين، وهو ابن ثلاث وستين سنة».":{"s":[19,60.598,10.656]},"خلقه":{"s":[19,71.604,1.872]},"كان يجلس جلسة العبد":{"s":[19,73.826,3.0]},"﴿وإنك لعلى خلق عظيم﴾":{"q":"68-4","o":"qs"},"«ولقد كان صلى الله عليه وآله يأكل على الأرض، ويجلس جلسة العبد، ويخصف بيده نعله، ويرقع بيده ثوبه، ويركب الحمار العاري، ويردف خلفه»":{"s":[19,77.176,14.472]},"«فأخرجه من أفضل المعادن منبتا، وأعز الأرومات مغرسا»":{"s":[20,0.0,6.24]},"عن الإمام الصادق عليه السلام: «كان رسول الله صلى الله عليه وآله يقسم لحظاته بين أصحابه، فينظر إلى ذا وينظر إلى ذا بالسوية … وإن كان ليصافحه الرجل فما يترك رسول الله صلى الله عليه وآله يده من يده حتى يكون هو التارك».":{"s":[20,6.59,21.312]},"وعن الإمام الباقر عليه السلام: «كان رسول الله صلى الله عليه وآله يأكل أكل العبد، ويجلس جلسة العبد، وكان يأكل على الحضيض، وينام على الحضيض».":{"s":[20,28.252,14.328]},"وعن أمير المؤمنين عليه السلام: «كان رسول الله صلى الله عليه وآله أجود الناس كفا، وأكرمهم عشرة، من خالطه فعرفه أحبه».":{"s":[20,42.93,12.744]},"«لست أدع ركوب الحمار مؤكفا، والأكل على الحصير مع العبيد، ومناولة السائل بيدي»":{"s":[20,56.024,8.256]},"من حديثه صلى الله عليه وآله":{"s":[20,64.63,4.08]},"من كلامه، كما في كتبنا":{"s":[20,69.06,3.456]},"«طلب العلم فريضة على كل مسلم، ألا إن الله يحب بغاة العلم»":{"s":[20,72.866,6.312]},"«الخلق عيال الله، فأحب الخلق إلى الله من نفع عيال الله، وأدخل على أهل بيت سرورا»":{"s":[20,79.528,8.64]},"«إن الرفق لم يوضع على شيء إلا زانه، ولا نزع من شيء إلا شانه»":{"s":[20,88.518,6.216]},"«إذا أحب أحدكم أخاه المسلم فليسأله عن اسمه، واسم أبيه، واسم قبيلته وعشيرته»":{"s":[21,0.0,8.544]},"«أعدل الناس من رضي للناس ما يرضى لنفسه، وكره لهم ما يكره لنفسه» … «وأفضل الناس إيمانا أحسنهم خلقا»":{"s":[21,8.894,9.96]},"«يا علي، لا يبغضك مؤمن، ولا يحبك منافق»":{"s":[21,19.204,5.424]},"أهل بيته من بعده":{"s":[21,24.978,2.592]},"الأئمة الاثنا عشر":{"s":[21,27.92,2.784]},"«إني تارك فيكم أمرين، إن أخذتم بهما لن تضلوا: كتاب الله عز وجل، وأهل بيتي عترتي … والثقلان كتاب الله جل ذكره وأهل بيتي» وفي رواية: «ألا وهما الخليفتان من بعدي، ولن يفترقا حتى يردا علي الحوض».":{"s":[21,31.054,21.096]},"تواريخ الوفاة والأعمار والمراقد في المشهد التالي من الكافي، ج، أبواب مواليد الأئمة عليهم السلام.":{"s":[21,52.5,10.416]},"علي بن أبي طالب":{"s":[21,63.266,2.736]},"أمير المؤمنين":{"s":[21,66.352,2.448]},"مضى رمضان ه، عن ثلاث وستين سنة":{"s":[21,69.15,8.208]},"الغري، النجف":{"s":[21,77.708,2.856]},"الحسن بن علي":{"s":[21,80.914,2.472]},"المجتبى":{"s":[21,83.736,1.992]},"مضى آخر صفر ه، عن سبع وأربعين سنة وأشهر":{"s":[21,86.078,8.04]},"البقيع، المدينة":{"s":[22,0.0,3.288]},"الحسين بن علي":{"s":[22,3.638,2.64]},"سيد الشهداء":{"s":[22,6.628,2.376]},"مضى محرم ه، عن سبع وخمسين سنة وأشهر":{"s":[22,9.354,8.136]},"كربلاء":{"s":[22,17.84,1.944]},"علي بن الحسين":{"s":[22,20.134,2.688]},"زين العابدين، السجاد":{"s":[22,23.172,3.792]},"مضى ه، عن سبع وخمسين سنة":{"s":[22,27.314,5.928]},"محمد بن علي":{"s":[22,33.592,2.544]},"الباقر":{"s":[22,36.486,1.872]},"جعفر بن محمد":{"s":[22,38.708,2.808]},"الصادق":{"s":[22,41.866,1.896]},"مضى شوال ه، عن خمس وستين سنة":{"s":[22,44.112,7.848]},"موسى بن جعفر":{"s":[22,52.31,2.496]},"الكاظم":{"s":[22,55.156,1.872]},"مضى رجب ه، عن أربع أو خمس وخمسين سنة":{"s":[22,57.378,8.928]},"مقابر قريش، بغداد":{"s":[22,66.656,3.624]},"علي بن موسى":{"s":[22,70.63,2.784]},"الرضا":{"s":[22,73.764,1.872]},"مضى صفر ه، عن خمس وخمسين سنة":{"s":[22,75.986,7.104]},"طوس، سناباد":{"s":[22,83.44,2.952]},"الجواد":{"s":[22,86.742,1.968]},"مضى آخر ذي القعدة ه، عن خمس وعشرين سنة":{"s":[22,89.06,7.656]},"مقابر قريش، عند جده موسى":{"s":[23,0.0,4.416]},"علي بن محمد":{"s":[23,4.766,2.712]},"الهادي":{"s":[23,7.828,1.92]},"مضى جمادى الآخرة ه، عن إحدى وأربعين سنة ونصف":{"s":[23,10.098,10.416]},"سر من رأى، في داره":{"s":[23,20.864,3.024]},"العسكري":{"s":[23,24.238,1.944]},"مضى ربيع الأول ه، عن ثمان وعشرين سنة":{"s":[23,26.532,8.232]},"سر من رأى، بجنب أبيه":{"s":[23,35.114,3.312]},"محمد بن الحسن":{"s":[23,38.776,2.688]},"المهدي المنتظر، عجل الله فرجه":{"s":[23,41.814,4.272]},"ولد للنصف من شعبان ه":{"s":[23,46.436,6.576]},"«وله قبل قيامه غيبتان»":{"s":[23,53.362,3.576]},"التسلسل":{"s":[23,57.288,1.968]},"حياته في فصلا":{"s":[23,59.606,3.648]},"علي عليه السلام، نهج البلاغة، الكلام":{"s":[23,63.604,6.984]},"ولقد قبض رسول الله صلى الله عليه وآله وإن رأسه لعلى صدري":{"s":[23,70.938,6.816]},"اللهم صل على محمد وآل محمد":{"s":[23,78.104,4.08]},"زيارته صلى الله عليه وآله":{"s":[23,82.534,3.888]},"علمها الإمام الصادق عليه السلام":{"s":[23,86.772,4.008]},"يرويها معاوية بن عمار عن أبي عبد الله الصادق عليه السلام، فيما يقال عند قبره صلى الله عليه وآله:":{"s":[24,0.0,9.888]},"أشهد أن لا إله إلا الله وحده لا شريك له، وأشهد أن محمدا عبده ورسوله، وأشهد أنك رسول الله، وأشهد أنك محمد بن عبد الله، وأشهد أنك قد بلغت رسالات ربك، ونصحت لأمتك، وجاهدت في سبيل الله، وعبدت الله مخلصا حتى أتاك اليقين …":{"s":[24,10.238,23.304]},"وأنك قد رؤفت بالمؤمنين، وغلظت على الكافرين، فبلغ الله بك أفضل شرف محل المكرمين. الحمد لله الذي استنقذنا بك من الشرك والضلالة.":{"s":[24,33.892,13.968]},"السلام عليك يا رسول الله ورحمة الله وبركاته":{"s":[24,48.21,5.424]},"المصادر":{"s":[24,53.984,2.04]},"من كتب الإمامية وحدها":{"s":[24,56.374,3.288]},"الكافيثقة الإسلام الكليني (ت ه)":{"s":[24,60.012,8.016]},"الإرشاد، ومسار الشيعة، والأماليالشيخ المفيد (ت ه)":{"s":[24,68.378,10.464]},"نهج البلاغةجمع الشريف الرضي (ت ه)، والترقيم وفق طبعة صبحي الصالح":{"s":[24,79.192,10.512]},"الأمالي، والخصالالشيخ الصدوق (ت ه)":{"s":[25,0.0,9.024]},"تفسير القميعلي بن إبراهيم القمي":{"s":[25,9.374,4.728]},"إعلام الورى بأعلام الهدىالفضل بن الحسن الطبرسي (ت ه)؛ صفحات النسب والشعب من الطبعة الحديثة، وصفحة المسجد من الطبعة الأخرى في مكتبة مدرسة الفقاهة":{"s":[25,14.452,18.168]},"مكارم الأخلاقالحسن بن الفضل الطبرسي":{"s":[25,32.97,4.992]},"عوالي اللآليابن أبي جمهور الأحسائي، في مشهد الخندق المأخوذ من سيرة علي":{"s":[25,38.312,7.8]},"بحار الأنوارالعلامة المجلسي (ت ه)، في مشهد الخندق، عن الكراجكي":{"s":[25,46.462,10.872]},"نصوص القرآن الكريم بالرسم الإملائي. وكل نص منسوب إلى نهج البلاغة روجع على طبعة صبحي الصالح، والنصوص الجديدة في هذه الصفحة طوبقت حرفا حرفا على صفحاتها في مكتبة مدرسة الفقاهة (lib.eshia.ir)، بعد توحيد الرسم وحذف الحركات وصيغ الصلاة والتسليم؛ والمشاهد المأخوذة من سيرة علي عليه السلام روجعت نصوصها هناك على كتبها. الصفحة عمل محبة غير رسمي. لا يرسم فيها وجه أحد: النبي صلى الله عليه وآله وأهل الكساء عليهم السلام بحجاب أبيض على الوجه وقرص ذهبي خلف الرأس، على عادة المنمنمات، وسائر الناس ظلال بلا ملامح.":{"s":[25,57.684,49.632]}},"q":{"105-3_4":["basit","minshawi","parhizgar"],"68-4":["basit","minshawi","parhizgar"],"48-1":["basit","minshawi","parhizgar"],"8-17a":["basit","minshawi"],"105-1":["basit","minshawi","parhizgar"],"96-1":["basit","minshawi","parhizgar"],"53-9":["basit","minshawi","parhizgar"],"33-33a":["basit","minshawi"],"53-14_17":["basit","minshawi","parhizgar"],"3-153a":["basit","minshawi"],"9-40a":["basit","minshawi"],"8-30":["basit","minshawi","parhizgar"],"33-9a":["basit","mi